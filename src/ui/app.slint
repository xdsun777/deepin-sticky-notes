// Compilation entry point. `build.rs` compiles this file, which pulls in the
// theme and note-window modules and re-exports their public types so that Rust
// can construct windows and the block model.

import { Theme } from "theme.slint";
import { NoteWindow, BlockItem } from "note_window.slint";

export { Theme, NoteWindow, BlockItem }
